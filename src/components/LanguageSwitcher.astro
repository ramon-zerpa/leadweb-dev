---
import { copy, locales, type Locale } from "../content/copy";

interface Props {
  locale: Locale;
  /** Only pass an existing equivalent page, including on privacy pages. */
  alternateHref?: string;
  fullNames?: boolean;
}

const { locale, alternateHref, fullNames = false } = Astro.props;
const otherLocale: Locale = locale === "en" ? "es" : "en";
const content = copy[locale];
---

<nav class:list={["language-switcher", { "language-switcher--full": fullNames }]} aria-label={content.nav.languageLabel}>
  <span lang={locale} aria-current="true">
    {fullNames ? locales[locale].name : content.nav.langCurrent}
  </span>
  <span aria-hidden="true">|</span>
  <a
    href={alternateHref}
    lang={otherLocale}
    hreflang={locales[otherLocale].hreflang}
    aria-label={locales[otherLocale].name}
    aria-disabled={!alternateHref || undefined}
  >
    <span>{fullNames ? locales[otherLocale].name : content.nav.langOther}</span>
  </a>
</nav>

<style>
  .language-switcher {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-muted-dark);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  a {
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    min-inline-size: 2.75rem;
    min-block-size: 2.75rem;
    color: inherit;
    text-decoration: none;
    transition: color var(--motion-fast) ease;
  }

  a:hover { color: var(--color-accent); }
  a[aria-disabled] { cursor: default; }
  [aria-current] { color: var(--color-paper); }
  .language-switcher--full { gap: var(--space-2); text-transform: uppercase; }
</style>
