---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";
import { copy, locales, type Locale } from "../content/copy";

interface Props {
  locale: Locale;
  href?: string;
}

const { locale, href = locales[locale].path } = Astro.props;
const content = copy[locale];
---

<a class="nav-brand" href={href} aria-label={`${content.brandFull} — ${content.nav.home}`} data-ui-id="site.brand">
  <Image
    src={logo}
    alt=""
    aria-hidden="true"
    width={54}
    height={54}
    widths={[44, 54, 88, 108]}
    sizes="(min-width: 64rem) 54px, 44px"
    format="webp"
    quality={90}
    loading="eager"
    decoding="async"
  />
  <span class="nav-brand-wordmark" aria-hidden="true">
    <span class="nav-brand-name">{content.brand}</span>
    <span class="nav-brand-signature">
      {Array.from(content.brandSignature).map((character) => (
        <span class:list={{ "nav-brand-cursor": character === "_" }} data-brand-cursor={character === "_" ? "" : undefined}>{character}</span>
      ))}
    </span>
  </span>
</a>

<style>
  .nav-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    inline-size: fit-content;
    min-block-size: 2.75rem;
    color: var(--color-paper);
    text-decoration: none;
  }

  img {
    inline-size: 2.75rem;
    block-size: 2.75rem;
    flex: none;
    object-fit: contain;
  }

  .nav-brand-wordmark {
    display: grid;
    gap: 0.1875rem;
    inline-size: max-content;
    flex: none;
    white-space: nowrap;
  }

  .nav-brand-name {
    font-size: 0.75rem;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0.02em;
  }

  .nav-brand-signature {
    /* Let the name set the width; distribute the code across the same span. */
    contain: inline-size;
    display: flex;
    justify-content: space-between;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1;
    color: #00cbd5;
  }

  @supports (background-clip: text) {
    .nav-brand-signature {
      background: var(--gradient-brand);
      background-clip: text;
      color: transparent;
    }
  }

  .nav-brand-cursor[data-orbit-running="true"] {
    animation: brand-caret 1.1s step-end infinite;
  }

  @keyframes brand-caret {
    0%, 54% { visibility: visible; }
    55%, 100% { visibility: hidden; }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-brand-cursor { animation: none !important; visibility: visible; }
  }

  @media (forced-colors: active) {
    .nav-brand-signature { background: none; color: LinkText; }
    .nav-brand-cursor { animation: none !important; visibility: visible; }
  }

  @media (min-width: 64rem) {
    .nav-brand { gap: 0.5rem; }
    img { inline-size: 3.375rem; block-size: 3.375rem; }
  }
</style>
