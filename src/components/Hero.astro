---
import HeroScene from "./HeroScene.astro";
import { copy, type Locale } from "../content/copy";

interface Props {
  locale: Locale;
  contactHref?: string;
  /** Enable when the selected-work section exists. */
  workHref?: string;
}

const { locale, contactHref, workHref } = Astro.props;
const content = copy[locale];
const hero = content.hero;
const id = locale === "en" ? "stand-out-stay-fast-win-trust" : "impacta-carga-rapido-inspira-confianza";
---

<section id={id} class="hero" data-locale={locale} aria-labelledby={`${id}-title`} data-ui-id="home.hero">
  <div class="hero-atmosphere" aria-hidden="true">
    <div class="hero-ambient-light" data-hero-ambient></div>
    <div class="hero-pointer-light" data-hero-light></div>
  </div>
  <div class="hero-layout container">
  <div class="hero-copy">
    <p class="hero-kicker eyebrow">{hero.kicker}</p>
    <h1 id={`${id}-title`} class="hero-title">
      {hero.lines.slice(0, 2).map((line) => <span>{line}</span>)}
      <span class="hero-typing-line" data-hero-typewriter data-phrases={JSON.stringify(hero.rotatingLines)} data-ui-id="home.hero.typewriter">
        <span class="sr-only">{hero.lines[2]}</span>
        {hero.rotatingLines.map((phrase) => (
          <span class="hero-typing-sizer" aria-hidden="true">{phrase}<span class="hero-typing-cursor"></span></span>
        ))}
        <span class="hero-typing-display" aria-hidden="true">
          <span data-typed-text>{hero.lines[2]}</span><span class="hero-typing-cursor"></span>
        </span>
      </span>
    </h1>
    <p class="hero-body">
      <span class="hero-body-intro">{hero.body.intro}</span>{" "}{hero.body.detail}<span class="hero-body-ending"> {hero.body.ending}</span>
    </p>
    <div class="hero-actions">
      <a class="hero-primary" href={contactHref ?? `mailto:${content.contact.email}`} data-ui-id="home.hero.contact">
        {hero.cta}
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M7 17 17 7M7 7h10v10" />
        </svg>
      </a>
      <a class="hero-secondary" href={workHref} role={workHref ? undefined : "link"} aria-disabled={workHref ? undefined : "true"} data-ui-id="home.hero.work">
        {hero.secondary} <span aria-hidden="true">↓</span>
      </a>
    </div>
  </div>
  <HeroScene locale={locale} id={`${id}-scene`} />
  </div>
</section>

<script>
  import "../scripts/hero-typewriter";
</script>

<style>
  .hero {
    --glow-x: 50%;
    --glow-y: 76%;
    position: relative;
    isolation: isolate;
  }

  .hero-layout {
    display: grid;
    gap: 1.375rem;
    padding-block: clamp(2.125rem, 4.444vw, 4rem) clamp(1.75rem, 5vw, 4.5rem);
  }

  .hero-atmosphere {
    position: absolute;
    z-index: -1;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    /* Fade before the section edge; light never meets a hard interior seam. */
    mask-image: linear-gradient(to bottom, transparent, #000 16%, #000 65%, transparent);
  }

  .hero-ambient-light, .hero-pointer-light {
    position: absolute;
    inset: 0;
    transform-origin: var(--glow-x) var(--glow-y);
    pointer-events: none;
  }

  .hero-ambient-light {
    background: radial-gradient(circle min(34rem, 75vw) at var(--glow-x) var(--glow-y), #35bfc43d, #12393e24 40%, transparent 78%);
    opacity: 0.6;
  }

  .hero-pointer-light {
    background: radial-gradient(circle min(30rem, 70vw) at var(--glow-x) var(--glow-y), #289da83b, #17485414 42%, transparent 76%);
    opacity: 0;
    transition: opacity 600ms ease;
  }

  .hero-copy {
    display: grid;
    gap: clamp(1.375rem, 1.806vw, 1.625rem);
    min-inline-size: 0;
    max-inline-size: 42rem;
  }

  .hero-kicker {
    max-inline-size: 26ch;
    font-size: 0.625rem;
    line-height: 1.6;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .hero-title {
    font-size: clamp(3rem, 16.667vw, 6.625rem);
    font-weight: 500;
    line-height: 1.01;
    letter-spacing: -0.047em;
    text-wrap: initial;
  }

  .hero-title > span { display: block; }
  .hero-title > span:last-child { color: var(--color-accent); }

  /* Overlay every complete phrase to reserve its natural size at each width. */
  .hero-title > .hero-typing-line {
    display: grid;
    min-inline-size: 0;
    font-weight: 700;
  }

  .hero-typing-sizer, .hero-typing-display {
    grid-area: 1 / 1;
    min-inline-size: 0;
  }

  .hero-typing-sizer {
    visibility: hidden;
    pointer-events: none;
  }

  @supports (background-clip: text) {
    [data-typed-text] {
      background: var(--gradient-brand);
      background-clip: text;
      color: transparent;
    }
  }

  @media (forced-colors: active) {
    [data-typed-text] { background: none; color: CanvasText; }
  }

  .hero-typing-cursor {
    display: inline-block;
    inline-size: 0.04em;
    block-size: 0.76em;
    margin-inline-start: 0.07em;
    background: currentColor;
    vertical-align: -0.015em;
    opacity: 0;
  }

  [data-typing-state="running"] .hero-typing-display .hero-typing-cursor {
    animation: hero-caret 1s step-end infinite;
  }

  [data-typing-state="paused"] .hero-typing-display .hero-typing-cursor { opacity: 1; }

  @keyframes hero-caret {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-typing-display .hero-typing-cursor { animation: none; opacity: 0; }
  }

  .hero[data-locale="es"] .hero-title {
    font-size: clamp(2.5rem, 13.846vw, 5.125rem);
    letter-spacing: -0.04em;
  }

  .hero-body {
    max-inline-size: 35.125rem;
    color: var(--color-muted-dark);
    font-size: clamp(1.0625rem, 0.95rem + 0.264vw, 1.1875rem);
    line-height: 1.55;
  }

  .hero-body-ending { display: none; }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem 1.75rem;
  }

  .hero-primary {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.75rem;
    inline-size: 100%;
    min-block-size: 3.75rem;
    padding: 1.125rem 1.375rem;
    border: 1px solid transparent;
    border-radius: 3px;
    background: var(--color-accent);
    color: var(--color-ink);
    font-weight: 600;
    line-height: 1.25;
    text-decoration: none;
    transition: background-color var(--motion-fast), border-color var(--motion-fast);
  }

  .hero-primary svg { flex: 0 0 auto; }
  .hero-primary:hover { background: var(--color-paper); }
  .hero-primary:focus-visible { outline-color: var(--color-paper); }

  .hero-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-block-size: 2.75rem;
    color: var(--color-paper);
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .hero-secondary[href]:hover { text-decoration: underline; }
  .hero-secondary[aria-disabled] { cursor: default; }

  @media (min-width: 48rem) {
    .hero-kicker { max-inline-size: none; font-size: 0.6875rem; letter-spacing: 0.127em; }
    .hero-body-intro { display: block; }
    .hero-body-ending { display: inline; }
    .hero-primary { inline-size: auto; }
  }

  @media (min-width: 64rem) {
    .hero {
      --glow-x: calc(50% + min(23vw, 22rem));
      --glow-y: 54%;
    }

    .hero-layout {
      grid-template-columns: minmax(0, 672fr) minmax(0, 596fr);
      align-items: center;
      gap: clamp(1.5rem, 3.056vw, 2.75rem);
    }

    .hero-title { font-size: clamp(4rem, 7.362vw, 6.625rem); }
    .hero[data-locale="es"] .hero-title { font-size: clamp(3rem, 5.695vw, 5.125rem); letter-spacing: -0.0366em; }
    .hero[data-locale="es"] .hero-typing-line { font-size: 0.98em; }
  }
</style>
