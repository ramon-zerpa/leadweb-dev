---
import { Picture } from "astro:assets";
import disocaPreview from "../assets/disoca-preview.png";
import { copy, type Locale } from "../content/copy";

interface Props {
  locale: Locale;
  id?: string;
  titleId?: string;
  uiId?: string;
}

const {
  locale,
  id = locale === "en"
    ? "built-for-purpose-made-to-be-noticed"
    : "hecho-con-proposito-hecho-para-verse",
  titleId = `${id}-title`,
  uiId = "home.selected-work",
} = Astro.props;
const work = copy[locale].work;
const titleLines = work.title.split("\n");
---

<section id={id} class="selected-work surface--paper" aria-labelledby={titleId} data-ui-id={uiId}>
  <div class="selected-work__inner container">
    <header class="selected-work__header" data-ui-id={`${uiId}.heading`}>
      <p class="selected-work__kicker eyebrow">{work.kicker}</p>
      <h2 id={titleId} class="selected-work__title">
        {titleLines.map((line) => <span>{line}</span>)}
      </h2>
    </header>

    <article class="selected-work__project" data-ui-id={`${uiId}.project`}>
      <figure class="project-preview" data-ui-id={`${uiId}.preview`}>
        <div class="project-preview__browser">
          <div class="project-preview__bar" aria-hidden="true">
            <span class="project-preview__controls"><i></i><i></i><i></i></span>
            <span>{work.previewUrl}</span>
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="5" y="11" width="14" height="9" rx="2" />
              <path d="M8 11V8a4 4 0 0 1 8 0v3" />
            </svg>
          </div>
          <div class="project-preview__crop">
            <div class="project-preview__media">
              <Picture
                src={disocaPreview}
                widths={[310, 538, 698]}
                sizes="(min-width: 64rem) 43.625rem, (min-width: 48rem) calc(100vw - 2 * var(--page-gutter)), calc(100vw - 5rem)"
                formats={["avif", "webp"]}
                alt={work.previewAlt}
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
        </div>
      </figure>

      <div class="project-copy" data-ui-id={`${uiId}.copy`}>
        <p class="project-copy__kicker eyebrow">{work.projectKicker}</p>
        <h3 class="project-copy__name">{work.projectName}</h3>
        <p class="project-copy__summary">{work.summary}</p>
        <p class="project-copy__description">{work.description}</p>
        <ul class="project-copy__tags">
          {work.tags.map((tag) => <li>{tag}</li>)}
        </ul>
        <a
          class="project-copy__link"
          href={work.href}
          target="_blank"
          rel="noopener noreferrer nofollow"
          data-ui-id={`${uiId}.link`}
        >
          {work.link}
          <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M7 17 17 7M7 7h10v10" />
          </svg>
        </a>
      </div>
    </article>

    <div class="selected-work__note" data-ui-id={`${uiId}.note`}>
      <p class="selected-work__note-label eyebrow">{work.noteLabel}</p>
      <p>{work.note}</p>
    </div>
  </div>
</section>

<style>
  .selected-work {
    padding-block: 3.5rem;
  }

  .selected-work__inner {
    display: grid;
    gap: 1.875rem;
  }

  .selected-work__header {
    display: grid;
    gap: 1.25rem;
  }

  .selected-work__kicker,
  .project-copy__kicker,
  .selected-work__note-label {
    color: #577075;
    font-size: 0.6875rem;
    letter-spacing: 0.109em;
    text-transform: uppercase;
  }

  .selected-work__title {
    max-inline-size: 13.5ch;
    color: var(--color-ink);
    font-size: clamp(2.5rem, 1.904rem + 2.646vw, 3.875rem);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.037em;
    text-wrap: initial;
  }

  .selected-work__title span { display: block; }

  .selected-work__project {
    display: grid;
    gap: 1.875rem;
  }

  .project-preview {
    aspect-ratio: 19 / 20;
    margin: 0;
    overflow: hidden;
    border-radius: 0.375rem;
    padding: 1.125rem 1rem;
    background: #dfe5e1;
  }

  .project-preview__browser {
    display: grid;
    grid-template-rows: 2rem minmax(0, 1fr);
    block-size: 100%;
    overflow: hidden;
    border: 1px solid #c2ccc5;
    border-radius: 0.25rem;
    background: #f3f5f4;
  }

  .project-preview__bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-inline-size: 0;
    padding-inline: 0.875rem;
    color: #62716d;
    background: #fff;
    font-family: var(--font-mono), monospace;
    font-size: 0.5625rem;
    line-height: 1;
  }

  .project-preview__bar > :last-child { justify-self: end; color: #80908b; }

  .project-preview__controls {
    display: flex;
    gap: 0.3125rem;
  }

  .project-preview__controls i {
    display: block;
    inline-size: 0.3125rem;
    block-size: 0.3125rem;
    border-radius: 50%;
    background: #b9c6c2;
  }

  .project-preview__crop { overflow: hidden; }
  .project-preview__media { inline-size: 100%; }
  .project-preview__media :global(img) { display: block; inline-size: 100%; block-size: auto; }

  .project-copy {
    display: grid;
    gap: 1.5625rem;
    align-content: center;
  }

  .project-copy__name {
    color: var(--color-ink);
    font-size: clamp(3rem, 2.405rem + 2.646vw, 4rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .project-copy__summary {
    max-inline-size: 21ch;
    color: var(--color-ink);
    font-size: clamp(1.5rem, 1.321rem + 0.794vw, 1.75rem);
    line-height: 1.2;
    letter-spacing: -0.018em;
  }

  .project-copy__description {
    max-inline-size: 31rem;
    color: #526865;
    font-size: 1rem;
    line-height: 1.6;
  }

  .project-copy__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project-copy__tags li {
    border: 1px solid #b8c5be;
    border-radius: 0.1875rem;
    padding: 0.4375rem 0.625rem;
    color: #244642;
    font-family: var(--font-mono), monospace;
    font-size: 0.6875rem;
    line-height: 1;
  }

  .project-copy__link {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: 1rem;
    min-block-size: 2.75rem;
    padding-block: 0.625rem;
    color: var(--color-ink);
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
  }

  .project-copy__link:hover { color: #244642; text-decoration: underline; }
  .project-copy__link svg { flex: none; }

  .selected-work__note {
    display: grid;
    gap: 0.75rem;
    border-block-start: 1px solid #cdd5ce;
    padding-block-start: 1.5rem;
    color: #294743;
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  @media (min-width: 48rem) {
    .selected-work {
      padding-block: clamp(4rem, 5.208vw, 5.5rem) clamp(4rem, 4.74vw, 5rem);
    }

    .selected-work__inner { gap: 2.75rem; }
    .selected-work__header { grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 2.5rem; }
    .project-preview { aspect-ratio: 770 / 588; padding: 2.25rem 2.25rem 0; }
    .selected-work__note { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; gap: 2rem; }
  }

  @media (min-width: 64rem) {
    .selected-work__project {
      grid-template-columns: minmax(0, 770fr) minmax(0, 490fr);
      align-items: center;
      gap: clamp(2rem, 3.611vw, 3.25rem);
    }

    .project-copy { gap: 1.5625rem; }
  }
</style>
