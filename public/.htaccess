# Astro fingerprints every generated asset in /_astro/.
# Cache only static asset extensions for repeat visits; HTML, robots and sitemaps
# keep the hosting defaults so content and indexation updates stay fresh.
<IfModule mod_headers.c>
  <FilesMatch "\.(?:avif|webp|png|css|js|mjs|woff2)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
