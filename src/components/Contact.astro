---
import { copy, type Locale } from "../content/copy";

interface Props {
  locale: Locale;
  id?: string;
  titleId?: string;
  uiId?: string;
}

const {
  locale,
  id = locale === "en"
    ? "lets-build-something-that-matters"
    : "construyamos-algo-que-importe",
  titleId = id + "-title",
  uiId = "home.contact",
} = Astro.props;
const contact = copy[locale].contact;
const founder = copy[locale].founder;
const footer = copy[locale].footer;
const titleLines = contact.title.split("\n");
const formAction = "https://formspree.io/f/xeoyljzz";
const fieldIds = {
  name: id + "-name",
  email: id + "-email",
  phone: id + "-phone",
  service: id + "-service",
  message: id + "-message",
};
---

<section id={id} class="contact" aria-labelledby={titleId} data-ui-id={uiId}>
  <div class="contact__inner container">
    <div class="contact__invitation" data-ui-id={uiId + ".invitation"}>
      <p class="contact__kicker eyebrow">{contact.kicker}</p>
      <h2 id={titleId} class="contact__title">
        {titleLines.map((line) => <span>{line}</span>)}
      </h2>
      <p class="contact__intro">{contact.body}</p>

      <address class="contact__alternatives" data-ui-id={uiId + ".alternatives"}>
        <a class="contact__email" href={"mailto:" + contact.email}>{contact.email}</a>
        <a
          class="contact__whatsapp"
          href={contact.whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
        >
          {contact.whatsappLabel}
        </a>
      </address>

      <nav class="contact__socials" aria-label={contact.socialsLabel} data-ui-id={uiId + ".socials"}>
        <a
          class="contact__social-link"
          href={founder.linkedinHref}
          target="_blank"
          rel="me noopener noreferrer"
        >
          {contact.linkedinLabel}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M7 17 17 7M7 7h10v10" />
          </svg>
        </a>
        <a
          class="contact__social-link"
          href={footer.instagramHref}
          target="_blank"
          rel="me noopener noreferrer"
        >
          {contact.instagramLabel}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M7 17 17 7M7 7h10v10" />
          </svg>
        </a>
      </nav>

      <p class="contact__location eyebrow">{contact.location}</p>
    </div>

    <form
      class="contact__form"
      action={formAction}
      method="post"
      accept-charset="UTF-8"
      data-contact-form
      data-ui-id={uiId + ".form"}
      data-sending={contact.sending}
      data-success-title={contact.successTitle}
      data-success={contact.success}
      data-error-title={contact.errorTitle}
      data-error={contact.error}
      data-invalid-email={contact.invalidEmail}
    >
      <div class="contact__field">
        <label for={fieldIds.name}>
          {contact.name} <span aria-hidden="true">*</span>
        </label>
        <input
          id={fieldIds.name}
          name="name"
          type="text"
          autocomplete="name"
          placeholder={contact.namePlaceholder}
          required
        />
      </div>

      <div class="contact__field">
        <label for={fieldIds.email}>
          {contact.emailLabel} <span aria-hidden="true">*</span>
        </label>
        <input
          id={fieldIds.email}
          name="email"
          type="email"
          autocomplete="email"
          inputmode="email"
          placeholder={contact.emailPlaceholder}
          required
        />
      </div>

      <div class="contact__field">
        <label for={fieldIds.phone}>{contact.phone}</label>
        <input
          id={fieldIds.phone}
          name="phone"
          type="tel"
          autocomplete="tel"
          inputmode="tel"
          placeholder={contact.phonePlaceholder}
        />
      </div>

      <fieldset class="contact__services">
        <legend>{contact.service}</legend>
        <div class="contact__service-options">
          {contact.services.map((service, index) => {
            const serviceId = fieldIds.service + "-" + index;

            return (
              <div class="contact__service-option">
                <input id={serviceId} name="service" type="radio" value={service.value} />
                <label for={serviceId}>{service.label}</label>
              </div>
            );
          })}
        </div>
      </fieldset>

      <div class="contact__field contact__field--message">
        <label for={fieldIds.message}>
          {contact.message} <span aria-hidden="true">*</span>
        </label>
        <textarea
          id={fieldIds.message}
          name="message"
          autocomplete="off"
          placeholder={contact.messagePlaceholder}
          required
        ></textarea>
      </div>

      <button class="contact__submit" type="submit" data-contact-submit>
        <span data-contact-submit-label>{contact.submit}</span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M7 17 17 7M7 7h10v10" />
        </svg>
      </button>

      <p class="contact__privacy">{contact.privacy}</p>
      <div class="contact__status" role="status" aria-live="polite" tabindex="-1" hidden data-contact-status>
        <p data-contact-status-title></p>
        <p data-contact-status-message></p>
      </div>
    </form>
  </div>
</section>

<script>
  const contactForms = document.querySelectorAll<HTMLFormElement>("[data-contact-form]");

  for (const form of contactForms) {
    const submit = form.querySelector<HTMLButtonElement>("[data-contact-submit]");
    const submitLabel = form.querySelector<HTMLElement>("[data-contact-submit-label]");
    const status = form.querySelector<HTMLElement>("[data-contact-status]");
    const statusTitle = form.querySelector<HTMLElement>("[data-contact-status-title]");
    const statusMessage = form.querySelector<HTMLElement>("[data-contact-status-message]");
    const email = form.elements.namedItem("email");
    const submitText = submitLabel?.textContent ?? "";

    const showStatus = (state: "success" | "error", title: string, message: string) => {
      if (!status || !statusTitle || !statusMessage) return;

      status.dataset.state = state;
      statusTitle.textContent = title;
      statusMessage.textContent = message;
      status.hidden = false;
      status.focus({ preventScroll: true });
    };

    const setSending = (sending: boolean) => {
      if (!submit || !submitLabel) return;

      submit.disabled = sending;
      submit.setAttribute("aria-busy", String(sending));
      submitLabel.textContent = sending ? form.dataset.sending ?? submitText : submitText;
    };

    if (email instanceof HTMLInputElement) {
      email.addEventListener("input", () => email.setCustomValidity(""));
      email.addEventListener("invalid", () => {
        if (email.validity.typeMismatch) {
          email.setCustomValidity(form.dataset.invalidEmail ?? "");
        }
      });
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (!form.reportValidity()) return;

      status?.setAttribute("hidden", "");
      setSending(true);

      try {
        const response = await fetch(form.action, {
          method: form.method,
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });

        if (!response.ok) throw new Error("Formspree rejected the request.");

        form.reset();
        showStatus(
          "success",
          form.dataset.successTitle ?? "",
          form.dataset.success ?? "",
        );
      } catch {
        showStatus(
          "error",
          form.dataset.errorTitle ?? "",
          form.dataset.error ?? "",
        );
      } finally {
        setSending(false);
      }
    });
  }
</script>

<style>
  .contact {
    padding-block: 3.5rem;
    color: var(--color-paper);
    background: var(--color-ink);
    color-scheme: dark;
  }

  .contact__inner {
    display: grid;
    gap: 2.25rem;
  }

  .contact__invitation {
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }

  .contact__kicker {
    color: var(--color-accent);
    font-size: 0.625rem;
    line-height: 1.3;
    letter-spacing: 0.091em;
    text-transform: uppercase;
  }

  .contact__title {
    color: var(--color-paper);
    font-size: 3rem;
    font-weight: 500;
    line-height: 1.03;
    letter-spacing: -0.0375em;
    text-wrap: initial;
  }

  .contact__title span { display: block; }

  .contact__intro {
    max-inline-size: 31rem;
    color: var(--color-muted-dark);
    font-size: 1.0625rem;
    line-height: 1.55;
  }

  .contact__alternatives {
    display: grid;
    gap: 0.875rem;
    min-block-size: 5.1875rem;
    padding-block: 0.75rem;
    font-style: normal;
  }

  .contact__email,
  .contact__whatsapp {
    justify-self: start;
    color: inherit;
    text-decoration: none;
  }

  .contact__email {
    color: var(--color-paper);
    font-size: 1.375rem;
    line-height: 1.23;
  }

  .contact__whatsapp {
    color: var(--color-muted-dark);
    font-size: 0.9375rem;
    line-height: 1.2;
  }

  .contact__alternatives a:hover { color: var(--color-accent); }

  .contact__socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-block: -0.5rem 0.5rem;
  }

  .contact__social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-block-size: 2.5rem;
    border: 1px solid var(--color-control-border);
    border-radius: 0.1875rem;
    padding: 0.5rem 0.75rem;
    color: var(--color-muted-dark);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.2;
    text-decoration: none;
    transition: border-color var(--motion-fast), color var(--motion-fast), background-color var(--motion-fast);
  }

  .contact__social-link:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: #53e3de12;
  }

  .contact__social-link svg { flex: none; }

  .contact__location {
    color: #8ca7a8;
    font-size: 0.625rem;
    line-height: 1.2;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .contact__form {
    display: grid;
    gap: 1.375rem;
    align-content: start;
  }

  .contact__field {
    display: grid;
    gap: 0.625rem;
  }

  .contact__field label,
  .contact__services legend {
    padding: 0;
    color: var(--color-paper);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.21;
  }

  .contact__field input,
  .contact__field textarea {
    inline-size: 100%;
    border: 1px solid var(--color-field-border);
    border-radius: 0.1875rem;
    background: #112125;
    color: var(--color-paper);
    font-size: 0.9375rem;
    line-height: 1.2;
  }

  .contact__field input {
    block-size: 2.875rem;
    padding-inline: 1rem;
  }

  .contact__field textarea {
    block-size: 7rem;
    padding: 1rem;
    resize: vertical;
  }

  .contact__field input::placeholder,
  .contact__field textarea::placeholder {
    color: #94aaaa;
    opacity: 1;
  }

  .contact__field input:focus,
  .contact__field textarea:focus {
    border-color: var(--color-accent);
    outline: 2px solid #53e3de4d;
    outline-offset: 2px;
  }

  .contact__services {
    display: grid;
    min-inline-size: 0;
    margin: 0;
    border: 0;
    padding: 0;
  }

  .contact__services legend { margin-block-end: 0.625rem; }

  .contact__service-options {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .contact__service-option {
    position: relative;
    min-inline-size: 0;
  }

  .contact__service-option input {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    opacity: 0;
  }

  .contact__service-option label {
    display: flex;
    align-items: center;
    justify-content: center;
    min-block-size: 2.25rem;
    border: 1px solid var(--color-control-border);
    border-radius: 0.1875rem;
    padding-inline: 0.375rem;
    color: var(--color-muted-dark);
    font-size: clamp(0.6875rem, 2.667vw, 0.8125rem);
    line-height: 1.1;
    text-align: center;
    cursor: pointer;
    transition: border-color var(--motion-fast), color var(--motion-fast), background-color var(--motion-fast);
  }

  .contact__service-option input:checked + label {
    border-color: var(--color-accent);
    color: var(--color-ink);
    background: var(--color-accent);
  }

  .contact__service-option input:focus-visible + label {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .contact__submit {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.75rem;
    min-block-size: 3.5rem;
    border: 1px solid var(--color-accent);
    border-radius: 0.1875rem;
    padding: 1rem 1.375rem;
    color: var(--color-ink);
    background: var(--color-accent);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.25;
    cursor: pointer;
    transition: color var(--motion-fast), background-color var(--motion-fast), border-color var(--motion-fast);
  }

  .contact__submit:hover {
    border-color: var(--color-paper);
    background: var(--color-paper);
  }

  .contact__submit:focus-visible { outline-color: var(--color-paper); }
  .contact__submit:disabled { cursor: wait; opacity: 0.85; }
  .contact__submit svg { flex: none; }

  .contact__privacy {
    color: #97afad;
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .contact__status {
    display: grid;
    gap: 0.25rem;
    border: 1px solid var(--color-control-border);
    border-radius: 0.1875rem;
    padding: 1rem;
    color: var(--color-muted-dark);
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .contact__status[data-state="success"] { border-color: var(--color-accent); }
  .contact__status[data-state="error"] { border-color: #df8f81; }
  .contact__status p:first-child { color: var(--color-paper); font-weight: 500; }

  @media (min-width: 48rem) {
    .contact {
      padding-block: clamp(4rem, 6.111vw, 5.5rem);
    }

    .contact__inner { gap: 3rem; }
    .contact__intro { max-inline-size: 34rem; }
    .contact__service-option label { font-size: 0.8125rem; }
  }

  @media (min-width: 64rem) {
    .contact__inner {
      grid-template-columns: minmax(0, 510fr) minmax(0, 692fr);
      align-items: start;
      gap: clamp(2.5rem, 8.385vw, 6.875rem);
    }

    .contact__invitation { gap: 1.875rem; }

    .contact__kicker { font-size: 0.6875rem; }

    .contact__title {
      font-size: clamp(3rem, 4.444vw, 4rem);
      letter-spacing: -0.034em;
    }

    .contact__intro { font-size: 1.125rem; }
    .contact__service-options { display: flex; }
    .contact__service-option label { padding-inline: 0.8125rem; }
  }
</style>
