---
interface Props {
  items: { label: string; href?: string }[];
  mode?: "desktop" | "mobile";
}

const { items, mode = "desktop" } = Astro.props;
---

<ul class:list={["nav-links", `nav-links--${mode}`]}>
  {items.map(({ label, href }, index) => (
    <li>
      <a href={href} aria-disabled={!href || undefined}>
        {mode === "mobile" && <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>}
        {label}
      </a>
    </li>
  ))}
</ul>

<style>
  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: flex;
    align-items: center;
    min-block-size: 2.75rem;
    color: var(--color-paper);
    font-size: 0.9375rem;
    text-decoration: none;
    transition: color var(--motion-fast) ease;
  }

  a[aria-disabled] { color: var(--color-muted-dark); cursor: default; }
  a:hover { color: var(--color-accent); }

  .nav-links--mobile {
    display: block;
  }

  .nav-links--mobile li {
    border-block-end: 1px solid var(--color-line);
  }

  .nav-links--mobile a {
    gap: 1.375rem;
    padding-block: 1.125rem;
    font-size: 2.375rem;
    line-height: 1.15;
    letter-spacing: -0.0625rem;
    overflow-wrap: anywhere;
  }

  .nav-links--mobile span {
    flex: none;
    color: var(--color-muted-dark);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: normal;
  }
</style>
