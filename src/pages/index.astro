---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Stats from "../components/Stats.astro";
import Work from "../components/Work.astro";
import Expertise from "../components/Expertise.astro";
import Founder from "../components/Founder.astro";
import Process from "../components/Process.astro";
import Testimonials from "../components/Testimonials.astro";
import Contact from "../components/Contact.astro";
import StickyWhatsApp from "../components/StickyWhatsApp.astro";
import BottomBar from "../components/BottomBar.astro";

const workId = "built-for-purpose-made-to-be-noticed";
const expertiseId = "more-than-a-website-a-business-tool";
const founderId = "the-person-behind-the-pixels";
const processId = "a-clear-process-no-black-box";
const reviewsId = "trust-earned-in-the-work";
const contactId = "lets-build-something-that-matters";
const contactHref = "#" + contactId;
---

<BaseLayout locale="en" alternates={{ en: "/", es: "/es/" }}>
  <Nav
    slot="header"
    locale="en"
    alternateHref="/es/"
    sectionLinks={{ work: "#" + workId, expertise: "#" + expertiseId, about: "#" + founderId, reviews: "#" + reviewsId }}
    contactHref={contactHref}
  />
  <Hero locale="en" contactHref={contactHref} workHref={"#" + workId} />
  <Stats locale="en" />
  <Work locale="en" id={workId} />
  <Expertise locale="en" id={expertiseId} />
  <Founder locale="en" id={founderId} />
  <Process locale="en" id={processId} />
  <Testimonials locale="en" id={reviewsId} />
  <Contact locale="en" id={contactId} />
  <StickyWhatsApp locale="en" />
  <BottomBar slot="footer" locale="en" />
</BaseLayout>
